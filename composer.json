{
  "name": "craftcms/digital-products",
  "description": "Sell digital product licenses with Craft Commerce",
  "type": "craft-plugin",
  "keywords": [
    "digital",
    "products",
    "commerce",
    "craftcms",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/commerce-digital-products/issues?state=open",
    "source": "https://github.com/craftcms/commerce-digital-products",
    "docs": "https://github.com/craftcms/commerce-digital-products",
    "rss": "https://github.com/craftcms/commerce-digital-products/commits/master.atom"
  },
  "require": {
    "php": "^8.5",
    "craftcms/cms": "6.x-dev",
    "craftcms/commerce": "6.x-dev"
  },
  "require-dev": {
    "larastan/larastan": "^3.4",
    "laravel/pint": "^1.24",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\DigitalProducts\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/",
      "CraftCms\\DigitalProducts\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "extra": {
    "handle": "digital-products",
    "name": "Digital Products",
    "developer": "Pixel & Tonic",
    "documentationUrl": "https://github.com/craftcms/commerce-digital-products/blob/6.x/README.md",
    "class": "CraftCms\\DigitalProducts\\Plugin"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "@php vendor/bin/pest",
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": [
      "@php vendor/bin/testbench package:create-sqlite-db --ansi",
      "@php vendor/bin/testbench vendor:publish --tag=craftcms-assets --force --ansi",
      "@php vendor/bin/testbench db:seed --class='Workbench\\Database\\Seeders\\DatabaseSeeder' --force --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ]
  }
}
